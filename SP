create procedure temptableinsertrow
      @stu_id bigint,
	  @stu_name varchar(50),
	  @joined_date date,
	  @marks int,
	  @status varchar(20),
	  @bmi decimal(2,1)
as
begin
    begin try
	   if exists (select * from tempdb.sys.tables where name like '%##temptables%')
	       begin
		     insert into ##temptables(id,names,joindate,mark,states,bmicalculator) values (@stu_id,@stu_name,@joined_date,@marks,@status,@bmi);
			 select * from #temptables;
			 print 'Succesully inserted the row'
		   end
	   else
	      begin
		     create table ##temptables( 
			     id bigint,
	             names varchar(50),
	             joindate date,
	             mark int,
	             states varchar(20),
	             bmicalculator decimal(2,1)
				 );
		  end
	  end try
	  begin catch
		print 'error occured '+error_message()
	  end catch
end

